# Copy to .env and replace every "change-me" value.
# Generate random values with:  openssl rand -hex 32
# Use hex/alphanumeric values for the passwords: they are embedded in database URLs.

# --- Database (required) ---
# Owner role `kitchen` (schema + seed) and the least-privilege runtime role `kitchen_app`.
POSTGRES_PASSWORD=change-me-postgres-owner
APP_DB_PASSWORD=change-me-app-db-user

# Host-side connection string for `npm run dev` (runtime role, loopback port).
DATABASE_URL=postgresql://kitchen_app:change-me-app-db-user@127.0.0.1:15432/kitchen

# --- Auth (required) ---
# At least 32 characters.
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# true when the app is served over HTTPS
COOKIE_SECURE=false

# --- The household (required, created by the one-shot init container) ---
# One login per person. SEED_USERS = comma list of short slugs (a-z, 0-9, dashes; default "alex,sam").
# Per slug: SEED_<SLUG>_PASSWORD (required, 12+ characters), SEED_<SLUG>_EMAIL (default <slug>@example.com),
# SEED_<SLUG>_NAME (default the slug, capitalised). Add a slug + password later and run `docker compose up -d`
# again to add a person; existing people keep their profile and data.
SEED_USERS=alex,sam,robin
SEED_ALEX_EMAIL=alex@example.com
SEED_ALEX_PASSWORD=change-me-12-chars-or-more
SEED_SAM_EMAIL=sam@example.com
SEED_SAM_PASSWORD=change-me-12-chars-or-more
SEED_ROBIN_EMAIL=robin@example.com
SEED_ROBIN_PASSWORD=change-me-12-chars-or-more

# --- Household (optional) ---
# IANA time zone for "today" in the food log, stock dates and the dashboard (default UTC).
# APP_TIMEZONE=America/Chicago
# Where you shop, used only to word AI prompts ("shopping in …"). Empty = generic.
# SHOP_REGION=
# Household tuna cap per week (mercury). Empty = no cap.
# TUNA_MAX_PER_WEEK=3

# --- Local AI (optional) ---
# Ollama on the host. Without it the app works; AI jobs (teach me, URL import, weekly plan,
# new-recipe feed, photo food log, lab-PDF import) stay queued until it is reachable.
# OLLAMA_URL=http://host.docker.internal:11434
# Default gemma4:12b (~8 GB). gemma4:31b (~20 GB RAM/VRAM) writes better recipes if you have the memory.
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# ComfyUI with a FLUX model for recipe pictures. Empty COMFYUI_MODEL = the FLUX checkpoint ComfyUI reports.
# COMFYUI_URL=http://host.docker.internal:8188
# COMFYUI_MODEL=
# Picture painting is OFF by default: nothing is sent to ComfyUI and recipes without a picture
# show a calm placeholder. on = the worker paints missing pictures (after text jobs, one at a time).
# IMAGE_GENERATION=off
# off = every AI job stays queued (no GPU use)
# WORKER=on

# --- Network (optional, all ports bound to 127.0.0.1) ---
# COOKINGSTUDIO_PORT=3030
# COOKINGSTUDIO_DB_PORT=15432
# Host allowlist, comma list (421 otherwise). Add the host:port you open in the browser.
# ALLOWED_HOSTS=127.0.0.1:3030,localhost:3030
# 1 only behind a reverse proxy that overwrites X-Forwarded-For
# TRUST_PROXY=0
